{
 "title": "작은 별님",
 "length": 76.0,
 "lines": [
  {
   "text": "하늘 위의 작은 별님",
   "start": 7.0,
   "end": 13.5
  },
  {
   "text": "반짝반짝 빛나요",
   "start": 13.5,
   "end": 20.0
  },
  {
   "text": "두 눈 감고 코 자자",
   "start": 20.0,
   "end": 26.5
  },
  {
   "text": "밤새도록 지켜 줄게",
   "start": 26.5,
   "end": 33.0
  },
  {
   "text": "달님도 방긋 웃어요",
   "start": 39.0,
   "end": 45.5
  },
  {
   "text": "은빛으로 안아 줘요",
   "start": 45.5,
   "end": 52.0
  },
  {
   "text": "꽃 꿈 꾸고 놀이 꿈 꿔",
   "start": 52.0,
   "end": 58.5
  },
  {
   "text": "내일 아침 또 만나요",
   "start": 58.5,
   "end": 65.0
  }
 ],
 "fp": "f03cae0b6e67"
}