{
 "title": "잘 자, 친구들",
 "length": 76.0,
 "lines": [
  {
   "text": "잘 자, 비프, 잘 자 친구야",
   "start": 7.0,
   "end": 13.5
  },
  {
   "text": "오늘 하루 즐거웠지",
   "start": 13.5,
   "end": 20.0
  },
  {
   "text": "가주도 미미도 하품하고",
   "start": 20.0,
   "end": 26.5
  },
  {
   "text": "판두도 눈을 감아요",
   "start": 26.5,
   "end": 33.0
  },
  {
   "text": "보보는 나무 위에서 쿨쿨",
   "start": 39.0,
   "end": 45.5
  },
  {
   "text": "히무도 새근새근 자요",
   "start": 45.5,
   "end": 52.0
  },
  {
   "text": "스파키, 로리, 스타더스트",
   "start": 52.0,
   "end": 58.5
  },
  {
   "text": "모두 코 자요, 너도 자요",
   "start": 58.5,
   "end": 65.0
  }
 ],
 "fp": "543092b7115c"
}