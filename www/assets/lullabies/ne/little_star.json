{
 "title": "सानो तारा",
 "length": 76.0,
 "lines": [
  {
   "text": "आकाशमा सानो तारा",
   "start": 7.0,
   "end": 13.5
  },
  {
   "text": "टिलिक टिलिक बल्छ प्यारा",
   "start": 13.5,
   "end": 20.0
  },
  {
   "text": "आँखा चिम्लौं, निदाऔं है",
   "start": 20.0,
   "end": 26.5
  },
  {
   "text": "रातभरि साथ रहन्छ यहाँ",
   "start": 26.5,
   "end": 33.0
  },
  {
   "text": "जून पनि मुस्कुराउँछ",
   "start": 39.0,
   "end": 45.5
  },
  {
   "text": "चाँदीको उज्यालोले अँगालो हाल्छ",
   "start": 45.5,
   "end": 52.0
  },
  {
   "text": "फूलको सपना, खेलको सपना",
   "start": 52.0,
   "end": 58.5
  },
  {
   "text": "भोलि बिहान फेरि भेटौंला",
   "start": 58.5,
   "end": 65.0
  }
 ],
