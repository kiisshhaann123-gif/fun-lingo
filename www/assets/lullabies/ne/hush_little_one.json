  {
   "text": "निदाऊ निदाऊ मेरो नानी",
   "start": 7.0,
   "end": 13.5
  },
  {
   "text": "थाकेको दिन सकियो अब",
   "start": 13.5,
   "end": 20.0
  },
  {
   "text": "सिमसिम पानी पर्दैछ बाहिर",
   "start": 20.0,
   "end": 26.5
  },
  {
   "text": "निदाएको गाउँमा बिस्तारै",
   "start": 26.5,
   "end": 33.0
  },
  {
   "text": "आमा यहीँ छिन्, बुबा पनि",
   "start": 39.0,
   "end": 45.5
  },
  {
   "text": "सधैं तिमीलाई माया गर्छौं",
   "start": 45.5,
   "end": 52.0
  },
  {
   "text": "निदाऊ निदाऊ, मीठो सपना",
   "start": 52.0,
   "end": 58.5
  },
  {
   "text": "शान्त खोलामा बग्दै जाऔं",
   "start": 58.5,
   "end": 65.0
  }
