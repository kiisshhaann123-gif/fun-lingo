{
 "title": "शुभरात्री साथीहरू",
 "length": 76.0,
 "lines": [
  {
   "text": "शुभरात्री बिप, शुभरात्री साथी",
   "start": 7.0,
   "end": 13.5
  },
  {
   "text": "रमाइलो दिन सकियो आज",
   "start": 13.5,
   "end": 20.0
  },
  {
   "text": "गजु र मिमीले हाई काढे",
   "start": 20.0,
   "end": 26.5
  },
  {
   "text": "पण्डुले पनि आँखा चिम्ले",
   "start": 26.5,
   "end": 33.0
  },
  {
   "text": "बोबो रूखमा गुटमुटिन्छ",
   "start": 39.0,
   "end": 45.5
  },
  {
   "text": "हिमु बिस्तारै घुर्दै सुत्छ",
   "start": 45.5,
   "end": 52.0
  },
  {
   "text": "स्पार्की, रोरी, स्टारडस्ट पनि",
   "start": 52.0,
   "end": 58.5
  },
  {
   "text": "सबै सुते, अब तिमी पनि",
   "start": 58.5,
   "end": 65.0
  }
