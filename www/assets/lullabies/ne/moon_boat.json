{
 "title": "जूनको डुङ्गा",
 "length": 76.0,
 "lines": [
  {
   "text": "जून त सानो डुङ्गा बन्यो",
   "start": 7.0,
   "end": 13.5
  },
  {
   "text": "निलो आकाशमा बिस्तारै चल्यो",
   "start": 13.5,
   "end": 20.0
  },
  {
   "text": "हल्लिँदै हल्लिँदै, यता र उता",
   "start": 20.0,
   "end": 26.5
  },
  {
   "text": "सपनाको देशमा जाऔं अब",
   "start": 26.5,
   "end": 33.0
  },
  {
   "text": "बादल त नरम सेतो सिरानी",
   "start": 39.0,
   "end": 45.5
  },
  {
   "text": "बतासले गाउँछ मीठो गीत",
   "start": 45.5,
   "end": 52.0
  },
  {
   "text": "हल्लिँदै हल्लिँदै, आँखा चिम्लौं",
   "start": 52.0,
   "end": 58.5
  },
  {
   "text": "घाम नउदाउन्जेल सुतौं है",
   "start": 58.5,
   "end": 65.0
  }
 ],
