eps_big_day.2": "Hello! My name is Beep!", "story.beeps_big_day.3": "Beep sees a red apple and a yellow banana.", "story.beeps_big_day.4": "Yummy!", "story.beeps_big_day.5": "Mom gives Beep rice and an egg.", "story.beeps_big_day.6": "Thank you!", "story.beeps_big_day.7": "Dad gives Beep milk and water.", "story.beeps_big_day.8": "A blue fish, a green butterfly, a black and white cow!", "story.beeps_big_day.9": "I love my big day! Bye-bye!"}, "ja": {"ph.01.asha": "こんにちは！", "ph.01.leo": "こんにちは！", "ph.02.asha": "これは ママ。", "ph.02.leo": "これは ママ。", "ph.03.asha": "てを ふって！", "ph.03.leo": "てを ふって！", "ph.04.asha": "はなを さわって！", "ph.04.leo": "はなを さわって！", "ph.06.asha": "いぬは ワンワン。", "ph.06.leo": "いぬは ワンワン。", "ph.07.asha": "うしは モーモー。", "ph.07.leo": "うしは モーモー。", "ph.08.asha": "さかなが およぐよ。", "ph.08.leo": "さかなが およぐよ。", "ph.09.asha": "さるが ジャンプ！", "ph.09.leo": "さるが ジャンプ！", "ph.11.asha": "あかだ！", "ph.11.leo": "あかだ！", "ph.12.asha": "きいろだ！", "ph.12.leo": "きいろだ！", "ph.13.asha": "くろい ねこ！", "ph.13.leo": "くろい ねこ！", "ph.14.asha": "ありがとう！", "ph.14.leo": "ありがとう！", "ph.16.asha": "おいしい！", "ph.16.leo": "おいしい！", "ph.17.asha": "みずが ほしい。", "ph.17.leo": "みずが ほしい。", "ph.18.asha": "ごはん ください。", "ph.18.leo": "ごはん ください。", "ph.19.asha": "わたしの なまえは アシャ です。", "ph.19.leo": "ぼくの なまえは レオ です。", "t.say_with_me.asha": "いっしょに いってみよう！", "t.your_turn.asha": "つぎは きみの ばん！", "t.say_with_me.leo": "いっしょに いってみよう！", "t.your_turn.leo": "つぎは きみの ばん！", "beep_intro.1": "こんにちは！ わたしは アシャ ねえさん。", "beep_intro.2": "ぼくは レオ にいさん！ こんにちは！", "beep_intro.3": "あれ？ これ なあに？", "beep_intro.4": "ピポパ！ こんにちは！", "beep_intro.5": "ビープだよ！ ビープは きみの ともだち。", "beep_intro.6": "やあ、ともだち！ いっしょに まなぼう！", "beep_intro.7": "ビープに こんにちは って いってみて！ こんにちは！", "beep_intro.8": "やったー！ ピポパ！", "story.who_says_hello.1": "ビープが おさんぽ。", "story.who_says_hello.2": "こんにちは！", "story.who_says_hello.3": "いぬだ！ いぬは ワンワン。", "story.who_says_hello.4": "ねこだ！ ねこは ニャー。", "story.who_says_hello.5": "うしだ！ うしは モーモー。", "story.who_says_hello.6": "とりだ！ とりは ピヨピヨ。", "story.who_says_hello.7": "ぞうと さる！", "story.who_says_hello.8": "みんなで こんにちは！", "story.who_says_hello.9": "こんにちは、みんな！ バイバイ！", "story.beeps_big_day.1": "きょうは ビープの とくべつな ひ！", "story.beeps_big_day.2": "こんにちは！ ぼくの なまえは ビープ！", "story.beeps_big_day.3": "ビープは あかい りんごと きいろい バナナを みつけた。", "story.beeps_big_day.4": "おいしそう！", "story.beeps_big_day.5": "ママが ビープに ごはんと たまごを くれた。", "story.beeps_big_day.6": "ありがとう！", "story.beeps_big_day.7": "パパが ぎゅうにゅうと みずを くれた。", "story.beeps_big_day.8": "あおい さかな、みどりの ちょうちょ、しろくろの うし！", "story.beeps_big_day.9": "とくべつな ひ、だいすき！ バイバイ！"}, "ko": {"ph.01.asha": "안녕하세요!", "ph.01.leo": "안녕하세요!", "ph.02.asha": "엄마예요.", "ph.02.leo": "엄마예요.", "ph.03.asha": "손을 흔들어요!", "ph.03.leo": "손을 흔들어요!", "ph.04.asha": "코를 만져요!", "ph.04.leo": "코를 만져요!", "ph.06.asha": "강아지는 멍멍.", "ph.06.leo": "강아지는 멍멍.", "ph.07.asha": "소는 음매.", "ph.07.leo": "소는 음매.", "ph.08.asha": "물고기가 헤엄쳐요.", "ph.08.leo": "물고기가 헤엄쳐요.", "ph.09.asha": "원숭이가 점프해요!", "ph.09.leo": "원숭이가 점프해요!", "ph.11.asha": "빨강이에요!", "ph.11.leo": "빨강이에요!", "ph.12.asha": "노랑이에요!", "ph.12.leo": "노랑이에요!", "ph.13.asha": "검은 고양이!", "ph.13.leo": "검은 고양이!", "ph.14.asha": "고마워요!", "ph.14.leo": "고마워요!", "ph.16.asha": "맛있어요!", "ph.16.leo": "맛있어요!", "ph.17.asha": "물 주세요.", "ph.17.leo": "물 주세요.", "ph.18.asha": "밥 주세요.", "ph.18.leo": "밥 주세요.", "ph.19.asha": "내 이름은 아샤예요.", "ph.19.leo": "내 이름은 레오예요.", "t.say_with_me.asha": "같이 말해요!", "t.your_turn.asha": "이제 해 볼까요?", "t.say_with_me.leo": "같이 말해요!", "t.your_turn.leo": "이제 해 볼까요?", "beep_intro.1": "안녕하세요! 저는 아샤 선생님이에요.", "beep_intro.2": "저는 레오 선생님이에요! 안녕하세요!", "beep_intro.3": "어? 이게 뭐지?", "beep_intro.4": "삐빅! 안녕!", "beep_intro.5": "비프예요! 비프는 네 친구예요.", "beep_intro.6": "안녕, 친구! 같이 배우자!", "beep_intro.7": "비프한테 인사해요! 안녕!", "beep_intro.8": "야호! 삐빅!", "story.who_says_hello.1": "비프가 산책해요.", "story.who_says_hello.2": "안녕!", "story.who_says_hello.3": "강아지예요! 강아지는 멍멍.", "story.who_says_hello.4": "고양이예요! 고양이는 야옹.", "story.who_says_hello.5": "소예요! 소는 음매.", "story.who_says_hello.6": "새예요! 새는 짹짹.", "story.who_says_hello.7": "코끼리랑 원숭이!", "story.who_says_hello.8": "모두 안녕!", "story.who_says_hello.9": "안녕, 친구들! 안녕!", "story.beeps_big_day.1": "오늘은 비프의 특별한 날이에요!", "story.beeps_big_day.2": "안녕! 내 이름은 비프야!", "story.beeps_big_day.3": "비프가 빨간 사과랑 노란 바나나를 봐요.", "story.beeps_big_day.4": "맛있겠다!", "story.beeps_big_day.5": "엄마가 비프에게 밥이랑 달걀을 줘요.", "story.beeps_big_day.6": "고마워요!", "story.beeps_big_day.7": "아빠가 우유랑 물을 줘요.", "story.beeps_big_day.8": "파란 물고기, 초록 나비, 하얗고 검은 소!", "story.beeps_big_day.9": "특별한 날 정말 좋아! 안녕!"}, "ne": {"ph.01.asha": "नमस्ते!", "ph.01.leo": "नमस्ते!", "ph.02.asha": "यो आमा हो।", "ph.02.leo": "यो आमा हो।", "ph.03.asha": "हात हल्लाऊ!", "ph.03.leo": "हात हल्लाऊ!", "ph.04.asha": "नाक छोऊ!", "ph.04.leo": "नाक छोऊ!", "ph.06.asha": "कुकुर भन्छ भुक भुक।", "ph.06.leo": "कुकुर भन्छ भुक भुक।", "ph.07.asha": "गाई भन्छ म्बाँ।", "ph.07.leo": "गाई भन्छ म्बाँ।", "ph.08.asha": "माछा पौडिन्छ।", "ph.08.leo": "माछा पौडिन्छ।", "ph.09.asha": "बाँदर उफ्रिन्छ।", "ph.09.leo": "बाँदर उफ्रिन्छ।", "ph.11.asha": "रातो हो!", "ph.11.leo": "रातो हो!", "ph.12.asha": "पहेँलो हो!", "ph.12.leo": "पहेँलो हो!", "ph.13.asha": "कालो बिरालो!", "ph.13.leo": "कालो बिरालो!", "ph.14.asha": "धन्यवाद!", "ph.14.leo": "धन्यवाद!", "ph.16.asha": "मीठो!", "ph.16.leo": "मीठो!", "ph.17.asha": "मलाई पानी चाहियो।", "ph.17.leo": "मलाई पानी चाहियो।", "ph.18.asha": "भात दिनुस् न।", "ph.18.leo": "भात दिनुस् न।", "ph.19.asha": "मेरो नाम आशा हो।", "ph.19.leo": "मेरो नाम लियो हो।", "t.say_with_me.asha": "सँगै भनौं!", "t.your_turn.asha": "अब तिम्रो पालो!", "t.say_with_me.leo": "सँगै भनौं!", "t.your_turn.leo": "अब तिम्रो पालो!", "beep_intro.1": "नमस्ते! म आशा दिदी।", "beep_intro.2": "अनि म लियो दाइ! नमस्ते!", "beep_intro.3": "ए! यो के हो?", "beep_intro.4": "बिप बुप! नमस्ते!", "beep_intro.5": "यो बिप हो! बिप तिम्रो साथी।", "beep_intro.6": "ए साथी! सँगै सिकौं!", "beep_intro.7": "बिपलाई नमस्ते भनौं! नमस्ते!", "beep_intro.8": "याहू! बिप बुप!", "story.who_says_hello.1": "बिप घुम्न जान्छ।", "story.who_says_hello.2": "नमस्ते!", "story.who_says_hello.3": "कुकुर! कुकुर भन्छ भुक भुक।", "story.who_says_hello.4": "बिरालो! बिरालो भन्छ म्याउ।", "story.who_says_hello.5": "गाई! गाई भन्छ म्बाँ।", "story.who_says_hello.6": "चरा! चरा भन्छ चिरबिर।", "story.who_says_hello.7": "हात्ती र बाँदर!", "story.who_says_hello.8": "सबैले भन्छन् नमस्ते!", "story.who_says_hello.9": "नमस्ते साथीहरू! टाटा!", "story.beeps_big_day.1": "आज बिपको खास दिन!", "story.beeps_big_day.2": "नमस्ते! मेरो नाम बिप हो!", "story.beeps_big_day.3": "बिपले रातो स्याउ र पहेँलो केरा देख्छ।", "story.beeps_big_day.4": "मीठो!", "story.beeps_big_day.5": "आमाले बिपलाई भात र अण्डा दिनुहुन्छ।", "story.beeps_big_day.6": "धन्यवाद!", "story.beeps_big_day.7": "बुबाले दूध र पानी दिनुहुन्छ।", "story.beeps_big_day.8": "निलो माछा, हरियो पुतली, कालो र सेतो गाई!", "story.beeps_big_day.9": "मलाई मेरो खास दिन मन पर्यो! टाटा!"}, "_speaker": {"w.hello.say": "asha", "w.bye.say": "asha", "w.mom.say": "leo", "w.mom.look": "leo", "w.mom.find": "leo", "w.mom.yes": "leo", "w.dad.say": "leo", "w.dad.look": "leo", "w.dad.find": "leo", "w.dad.yes": "leo", "w.baby.say": "asha", "w.baby.look": "asha", "w.baby.find": "asha", "w.baby.yes": "asha", "w.hand.say": "asha", "w.hand.look": "asha", "w.hand.find": "asha", "w.hand.yes": "asha", "w.eyes.say": "leo", "w.eyes.look": "leo", "w.eyes.find": "leo", "w.eyes.yes": "leo", "w.nose.say": "leo", "w.nose.look": "leo", "w.nose.find": "leo", "w.nose.yes": "leo", "w.dog.say": "leo", "w.dog.look": "leo", "w.dog.find": "leo", "w.dog.yes": "leo", "w.cat.say": "leo", "w.cat.look": "leo", "w.cat.find": "leo", "w.cat.yes": "leo", "w.cow.say": "asha", "w.cow.look": "asha", "w.cow.find": "asha", "w.cow.yes": "asha", "w.bird.say": "asha", "w.bird.look": "asha", "w.bird.find": "asha", "w.bird.yes": "asha", "w.fish.say": "leo", "w.fish.look": "leo", "w.fish.find": "leo", "w.fish.yes": "leo", "w.butterfly.say": "leo", "w.butterfly.look": "leo", "w.butterfly.find": "leo", "w.butterfly.yes": "leo", "w.elephant.say": "asha", "w.elephant.look": "asha", "w.elephant.find": "asha", "w.elepha